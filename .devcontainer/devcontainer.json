{
  "name": "EDH simulator development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "EDH Observatory",
      "onAutoForward": "notify"
    }
  }
}
